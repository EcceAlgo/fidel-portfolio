@startuml mcd

title Modèle conceptuel de données — Fidel Portfolio

hide methods
hide stereotypes
skinparam linetype ortho
skinparam shadowing false

entity "Profil" as Profil {
  * id_profil
  nom_affiche
  positionnement_professionnel
  email_contact
  lien_github
  lien_linkedin
}

entity "Projet" as Projet {
  * id_projet
  titre
  description
  lien_demonstration
  statut_depot
  lien_depot
}

entity "Catégorie" as Categorie {
  * id_categorie
  nom
}

entity "Technologie" as Technologie {
  * id_technologie
  nom
}

entity "Ressource_visuelle" as RessourceVisuelle {
  * id_ressource
  reference_ressource
  texte_alternatif
  ordre_affichage
}

Categorie "0,n" -- "1,n" Projet : Classer

Projet "0,n" -- "0,n" Technologie : Utiliser

Projet "0,n" -- "1,1" RessourceVisuelle : Illustrer

@enduml
